# =====================================================================
# KA Tech Hub — configuration de l'API
# =====================================================================
# Copier ce fichier en « api/.env » et le renseigner.
# Le vrai .env n'est JAMAIS versionné (voir api/.gitignore) et n'est JAMAIS
# téléchargeable : api/.htaccess le bloque. Vérifiez-le après déploiement en
# ouvrant https://votre-domaine/api/.env — vous devez obtenir un 403.
# =====================================================================

# ---------------------------------------------------------------------
# Environnement
# ---------------------------------------------------------------------
# « production » (défaut) : aucune trace d'erreur n'est renvoyée au client,
#                           tout part dans le journal d'erreurs PHP.
# « dev »                 : le détail des exceptions est renvoyé dans la
#                           réponse JSON. À ne JAMAIS activer en ligne.
APP_ENV=production

# ---------------------------------------------------------------------
# Base de données — le seul réglage vraiment structurant
# ---------------------------------------------------------------------
# TROIS valeurs possibles, et trois seulement :
# « sqlite » : un fichier unique, zéro configuration, à condition que
#              pdo_sqlite soit activé et qu'un dossier soit inscriptible.
# « mysql »  : garanti chez tout hébergeur mutualisé.
# « pgsql »  : PostgreSQL — serveur autonome, ou service hébergé
#              (Supabase, Neon, Railway). Exige l'extension pdo_pgsql.
DB_DRIVER=mysql

# --- Si DB_DRIVER=sqlite ---------------------------------------------
# CRITIQUE : ce chemin doit pointer HORS de public_html, sinon la base
# entière est téléchargeable par HTTP. Chemin absolu recommandé.
#   correct   : /home/monuser/katech-data/katech.sqlite
#   DANGEREUX : /home/monuser/public_html/katech.sqlite
# Le DOSSIER doit être inscriptible (SQLite y crée aussi -wal et -shm).
DB_SQLITE_PATH=/home/monuser/katech-data/katech.sqlite

# --- Si DB_DRIVER=mysql OU pgsql -------------------------------------
# Les valeurs viennent du panneau de l'hébergeur.
# Chez beaucoup de mutualisés, DB_HOST vaut « localhost » et non « 127.0.0.1 ».
# DB_PORT : 3306 en MySQL, 5432 en PostgreSQL. Il n'y a PAS de défaut commun —
# laisser 3306 avec DB_DRIVER=pgsql donne un « connexion refusée » qui n'a
# aucun rapport apparent avec le port.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=katech
DB_USER=katech
DB_PASSWORD=

# --- Si DB_DRIVER=pgsql, en plus -------------------------------------
# Mode TLS transmis à libpq. Valeurs utiles :
#   (vide)   laisse le défaut « prefer » — convient à un PostgreSQL local ;
#   require  chiffrement OBLIGATOIRE, sans vérification du certificat ;
#   verify-full  chiffrement + vérification du nom d'hôte (le plus sûr, à
#                condition que les certificats racine soient installés).
# Un service hébergé REFUSE les connexions en clair : sans DB_SSLMODE=require,
# la connexion échoue sans que le message parle de TLS.
# DB_SSLMODE=

# Chez Supabase, précisément (section « Database » du tableau de bord) :
#   DB_HOST      db.<référence-du-projet>.supabase.co
#   DB_PORT      5432   — connexion DIRECTE. Ne pas prendre 6543 (pooler en
#                mode transaction) : il met en défaut les requêtes réellement
#                préparées côté serveur qu'utilise ce projet.
#   DB_NAME      postgres
#   DB_USER      postgres
#   DB_SSLMODE   require
# La base n'est PAS créée automatiquement : elle doit exister avant
# d'ouvrir /api/install.php.

# ---------------------------------------------------------------------
# Routage
# ---------------------------------------------------------------------
# Préfixe sous lequel l'API est montée. Laisser vide pour détection
# automatique depuis l'emplacement de index.php (convient à /api).
# À forcer si un proxy réécrit les URL.
# API_BASE_PATH=/api

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
# À laisser VIDE en production : le frontend est servi par le même domaine,
# aucune requête n'est cross-origin.
# En développement, Vite tourne sur un autre port : listez l'origine exacte,
# séparée par des virgules. « * » est inutilisable ici, car le client envoie
# credentials: include (authentification par cookie).
CORS_ORIGINS=

# ---------------------------------------------------------------------
# SMTP — envoi d'emails transactionnels (vague 4.5)
# ---------------------------------------------------------------------
# Si SMTP_HOST est vide, les emails sont désactivés (le site fonctionne
# quand même, mais aucun email n'est envoyé).
#
# Hébergements courants :
#   Gmail / Google Workspace : smtp.gmail.com        port 587  encryption tls
#   OVH                      : pro1.mail.ovh.net      port 587  encryption tls
#   Brevo (SendinBlue)       : smtp-relay.brevo.com  port 587  encryption tls
#
# SMTP_ENCRYPTION : « tls » (STARTTLS, port 587 — recommandé)
#                   « ssl » (SSL direct, port 465)
#                   « none » (non recommandé)
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@votre-domaine.dz
SMTP_FROM_NAME=KA Tech Hub

# Mode simulation : écrit les emails dans SMTP_SIMULATE_DIR au lieu de les
# envoyer. Utile en développement.
# SMTP_SIMULATE=1
# SMTP_SIMULATE_DIR=/tmp/katech-mail

# URL publique de l'application frontend (dans les liens des emails).
# Exemple : https://www.katech.dz  — sans barre oblique finale.
APP_URL=

# Email du commerçant pour les notifications de nouvelles commandes.
# Laisser vide pour désactiver ces notifications.
NOTIFY_OWNER_EMAIL=
NOTIFY_OWNER_NAME=KA Tech Hub

# ---------------------------------------------------------------------
# Limitation de débit — /auth/login et /auth/forgot-password (vague 4.5)
# ---------------------------------------------------------------------
# Protège contre la force brute. Les valeurs ci-dessous sont les défauts.
# RATE_LIMIT_MAX_IP=20
# RATE_LIMIT_MAX_CIBLE=10
# RATE_LIMIT_FENETRE=900
# RATE_LIMIT_VERROU=900

# ---------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------
# Dossier de stockage des fichiers de session. À renseigner si l'hébergeur
# partage /tmp entre plusieurs comptes, ou si les sessions « sautent » sans
# raison. Le dossier doit être inscriptible et HORS de public_html.
# SESSION_SAVE_PATH=/home/monuser/katech-data/sessions

# Durée de vie ABSOLUE d'une session, en secondes (défaut 43200 = 12 h).
# SESSION_TTL_SECONDS=43200

# Durée d'INACTIVITÉ avant déconnexion, en secondes (défaut 7200 = 2 h).
# SESSION_IDLE_SECONDS=7200

# Chemin du cookie de session (défaut « / »).
# SESSION_COOKIE_PATH=/

# ---------------------------------------------------------------------
# Téléversement de médias
# ---------------------------------------------------------------------
# Contrairement à la base, les médias DOIVENT être servis par HTTP : ils
# vivent donc dans public_html/uploads. C'est voulu. La racine .htaccess
# empêche l'exécution de tout script qui y serait déposé.
# Défaut : <racine du compte>/public_html/uploads
# UPLOAD_DIR=/home/monuser/public_html/uploads

# URL publique correspondant à UPLOAD_DIR (défaut « /uploads »).
# UPLOAD_BASE_URL=/uploads

# Taille maximale d'un fichier téléversé, en octets (défaut 5242880 = 5 Mo).
# Ne peut pas dépasser upload_max_filesize / post_max_size de PHP, réglés
# dans le panneau de l'hébergeur.
# UPLOAD_MAX_BYTES=5242880

# ---------------------------------------------------------------------
# Outbox — CRON d'émission des événements (api/tools/vider-outbox.php)
# ---------------------------------------------------------------------
# Destination générique des événements. Si vide, les événements qui ne sont
# pas traités localement restent en attente, sans être perdus.
# OUTBOX_WEBHOOK_URL=
# OUTBOX_WEBHOOK_SECRET=
# OUTBOX_BATCH_SIZE=50

# ---------------------------------------------------------------------
# Sauvegardes — CRON (api/tools/sauvegarder.php)
# ---------------------------------------------------------------------
# Dossier de destination. IMPÉRATIVEMENT HORS de public_html : une
# sauvegarde téléchargeable, c'est toute la base — clients, commandes,
# mots de passe hachés — livrée à qui devine son nom. Le script REFUSE de
# s'exécuter si ce chemin est dans la racine web.
# Défaut : <dossier parent de public_html>/katech-data/backups
# BACKUP_DIR=/home/monuser/katech-data/backups

# Nombre de sauvegardes conservées ; au-delà, les plus anciennes sont
# supprimées après chaque exécution réussie (défaut 14).
# BACKUP_KEEP=14

# Compression gzip des sauvegardes (défaut 1). Mettre 0 pour désactiver.
# BACKUP_COMPRESS=1

# ---------------------------------------------------------------------
# Compte propriétaire — lu UNE SEULE FOIS par install.php
# ---------------------------------------------------------------------
# Renseignez-les avant d'ouvrir install.php, puis effacez-les du .env.
# Le mot de passe est haché en Argon2id, jamais stocké en clair.
INSTALL_OWNER_NAME=Propriétaire
INSTALL_OWNER_EMAIL=
INSTALL_OWNER_PASSWORD=
