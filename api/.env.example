# =====================================================================
# KA Tech Hub — configuration de l'API
# =====================================================================
# Copier ce fichier en « api/.env » et le renseigner.
# Le vrai .env n'est JAMAIS versionné (voir api/.gitignore) et n'est JAMAIS
# téléchargeable : api/.htaccess le bloque. Vérifiez-le après déploiement en
# ouvrant https://votre-domaine/api/.env — vous devez obtenir un 403.
# =====================================================================

# ---------------------------------------------------------------------
# Environnement
# ---------------------------------------------------------------------
# « production » (défaut) : aucune trace d'erreur n'est renvoyée au client,
#                           tout part dans le journal d'erreurs PHP.
# « dev »                 : le détail des exceptions est renvoyé dans la
#                           réponse JSON. À ne JAMAIS activer en ligne.
APP_ENV=production

# ---------------------------------------------------------------------
# Base de données — le seul réglage vraiment structurant
# ---------------------------------------------------------------------
# « sqlite » : un fichier unique, zéro configuration, à condition que
#              pdo_sqlite soit activé et qu'un dossier soit inscriptible.
# « mysql »  : garanti chez tout hébergeur mutualisé.
DB_DRIVER=mysql

# --- Si DB_DRIVER=sqlite ---------------------------------------------
# CRITIQUE : ce chemin doit pointer HORS de public_html, sinon la base
# entière est téléchargeable par HTTP. Chemin absolu recommandé.
#   correct   : /home/monuser/katech-data/katech.sqlite
#   DANGEREUX : /home/monuser/public_html/katech.sqlite
# Le DOSSIER doit être inscriptible (SQLite y crée aussi -wal et -shm).
DB_SQLITE_PATH=/home/monuser/katech-data/katech.sqlite

# --- Si DB_DRIVER=mysql ----------------------------------------------
# Les quatre valeurs viennent du panneau de l'hébergeur.
# Chez beaucoup de mutualisés, DB_HOST vaut « localhost » et non « 127.0.0.1 ».
DB_HOST=localhost
DB_PORT=3306
DB_NAME=katech
DB_USER=katech
DB_PASSWORD=

# ---------------------------------------------------------------------
# Routage
# ---------------------------------------------------------------------
# Préfixe sous lequel l'API est montée. Laisser vide pour détection
# automatique depuis l'emplacement de index.php (convient à /api).
# À forcer si un proxy réécrit les URL.
# API_BASE_PATH=/api

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
# À laisser VIDE en production : le frontend est servi par le même domaine,
# aucune requête n'est cross-origin.
# En développement, Vite tourne sur un autre port : listez l'origine exacte,
# séparée par des virgules. « * » est inutilisable ici, car le client envoie
# credentials: include (authentification par cookie).
CORS_ORIGINS=

# ---------------------------------------------------------------------
# Compte propriétaire — lu UNE SEULE FOIS par install.php
# ---------------------------------------------------------------------
# Renseignez-les avant d'ouvrir install.php, puis effacez-les du .env.
# Le mot de passe est haché en Argon2id, jamais stocké en clair.
INSTALL_OWNER_NAME=Propriétaire
INSTALL_OWNER_EMAIL=
INSTALL_OWNER_PASSWORD=
