# =====================================================================
# KA Tech Hub — configuration de l'API
# =====================================================================
#
# DÉMARRAGE RAPIDE — les 4 lignes à renseigner avant tout
# ─────────────────────────────────────────────────────────────────────
# 1. Copiez CE fichier en « api/.env » (renommez-le, ne supprimez pas
#    l'original).
# 2. Remplissez les quatre variables ci-dessous (section "Base de
#    données" et "Compte propriétaire").
# 3. Ouvrez https://votre-domaine/api/install.php dans votre navigateur.
# 4. Après l'installation, effacez INSTALL_OWNER_PASSWORD du .env.
#
# Le reste du fichier documente les réglages avancés — tous optionnels.
# Vous pouvez les ignorer au premier déploiement.
#
# SÉCURITÉ : le .env n'est JAMAIS versionné et n'est JAMAIS
# téléchargeable (api/.htaccess le bloque). Vérifiez après déploiement
# en ouvrant https://votre-domaine/api/.env — vous devez obtenir un 403.
# =====================================================================

# ---------------------------------------------------------------------
# Base de données — renseignez ces valeurs avant install.php
# ---------------------------------------------------------------------
# Votre panneau d'hébergeur (Hostinger hPanel, cPanel…) vous fournit
# ces quatre informations dans la section « Bases de données MySQL » :
#   Nom de la base  → DB_NAME
#   Utilisateur     → DB_USER
#   Mot de passe    → DB_PASSWORD
#   Hôte            → DB_HOST (souvent « localhost » chez un mutualisé)
#
# Pour MySQL (Hostinger, OVH, LWS — le cas habituel) :
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Pour PostgreSQL (Supabase, Neon, Railway, ou un VPS) :
# DB_DRIVER=pgsql
# DB_HOST=db.<reference>.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSLMODE=require
#
# Pour SQLite (hébergement sans MySQL accessible, ou test local) :
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=/home/monuser/katech-data/katech.sqlite
# CRITIQUE : ce chemin doit pointer HORS de public_html (la base
# entière serait téléchargeable sinon). Le DOSSIER doit être
# inscriptible par PHP.

# ---------------------------------------------------------------------
# Compte propriétaire — lu UNE SEULE FOIS par install.php
# ---------------------------------------------------------------------
# Renseignez-les avant d'ouvrir install.php, puis effacez-les du .env.
# Le mot de passe est haché en Argon2id, jamais stocké en clair.
#
# Règle du mot de passe : au moins 10 caractères, pas de suite évidente
# (« changeme », « admin1234 »…). Utilisez une phrase de passe.
INSTALL_OWNER_NAME=Propriétaire
INSTALL_OWNER_EMAIL=
INSTALL_OWNER_PASSWORD=

# =====================================================================
# RÉGLAGES AVANCÉS — tous optionnels, à lire si nécessaire
# =====================================================================

# ---------------------------------------------------------------------
# Environnement
# ---------------------------------------------------------------------
# « production » (défaut) : aucune trace d'erreur n'est renvoyée au
#                           client, tout part dans le journal PHP.
# « dev »                 : le détail des exceptions est renvoyé dans
#                           la réponse JSON. À ne JAMAIS activer
#                           en ligne.
APP_ENV=production

# ---------------------------------------------------------------------
# Routage
# ---------------------------------------------------------------------
# Préfixe sous lequel l'API est montée. Laisser vide pour détection
# automatique depuis l'emplacement de index.php (convient à /api).
# À forcer si un proxy réécrit les URL.
# API_BASE_PATH=/api

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------
# À laisser VIDE en production : le frontend est servi par le même
# domaine, aucune requête n'est cross-origin.
# En développement, Vite tourne sur un autre port : listez l'origine
# exacte, séparée par des virgules. « * » est inutilisable ici, car
# le client envoie credentials: include (authentification par cookie).
CORS_ORIGINS=

# ---------------------------------------------------------------------
# SMTP — envoi d'emails transactionnels (vague 4.5)
# ---------------------------------------------------------------------
# Si SMTP_HOST est vide, les emails sont désactivés (le site
# fonctionne quand même, mais aucun email n'est envoyé).
#
# Hébergements courants :
#   Gmail / Google Workspace : smtp.gmail.com        port 587  encryption tls
#   OVH                      : pro1.mail.ovh.net      port 587  encryption tls
#   Brevo (SendinBlue)       : smtp-relay.brevo.com  port 587  encryption tls
#
# SMTP_ENCRYPTION : « tls » (STARTTLS, port 587 — recommandé)
#                   « ssl » (SSL direct, port 465)
#                   « none » (non recommandé)
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@votre-domaine.dz
SMTP_FROM_NAME=KA Tech Hub

# Mode simulation : écrit les emails dans SMTP_SIMULATE_DIR au lieu
# de les envoyer. Utile en développement.
# SMTP_SIMULATE=1
# SMTP_SIMULATE_DIR=/tmp/katech-mail

# URL publique de l'application frontend (dans les liens des emails).
# Exemple : https://www.katech.dz  — sans barre oblique finale.
APP_URL=

# Email du commerçant pour les notifications de nouvelles commandes.
# Laisser vide pour désactiver ces notifications.
NOTIFY_OWNER_EMAIL=
NOTIFY_OWNER_NAME=KA Tech Hub

# ---------------------------------------------------------------------
# Limitation de débit — /auth/login et /auth/forgot-password (vague 4.5)
# ---------------------------------------------------------------------
# Protège contre la force brute. Les valeurs ci-dessous sont les défauts.
# RATE_LIMIT_MAX_IP=20
# RATE_LIMIT_MAX_CIBLE=10
# RATE_LIMIT_FENETRE=900
# RATE_LIMIT_VERROU=900

# ---------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------
# Dossier de stockage des fichiers de session. À renseigner si
# l'hébergeur partage /tmp entre plusieurs comptes, ou si les sessions
# « sautent » sans raison. Le dossier doit être inscriptible et HORS
# de public_html.
# SESSION_SAVE_PATH=/home/monuser/katech-data/sessions

# Durée de vie ABSOLUE d'une session, en secondes (défaut 43200 = 12 h).
# SESSION_TTL_SECONDS=43200

# Durée d'INACTIVITÉ avant déconnexion, en secondes (défaut 7200 = 2 h).
# SESSION_IDLE_SECONDS=7200

# Chemin du cookie de session (défaut « / »).
# SESSION_COOKIE_PATH=/

# ---------------------------------------------------------------------
# Téléversement de médias
# ---------------------------------------------------------------------
# Contrairement à la base, les médias DOIVENT être servis par HTTP :
# ils vivent donc dans public_html/uploads. C'est voulu. La racine
# .htaccess empêche l'exécution de tout script qui y serait déposé.
# Défaut : <racine du compte>/public_html/uploads
# UPLOAD_DIR=/home/monuser/public_html/uploads

# URL publique correspondant à UPLOAD_DIR (défaut « /uploads »).
# UPLOAD_BASE_URL=/uploads

# Taille maximale d'un fichier téléversé, en octets
# (défaut 5242880 = 5 Mo). Ne peut pas dépasser upload_max_filesize
# / post_max_size de PHP, réglés dans le panneau de l'hébergeur.
# UPLOAD_MAX_BYTES=5242880

# ---------------------------------------------------------------------
# Outbox — émission des événements (api/tools/vider-outbox.php)
# ---------------------------------------------------------------------
# Les emails de confirmation sont émis en fin de requête, sans CRON.
# Ces variables concernent une destination webhook optionnelle pour les
# autres événements. Si vides, les événements non traités localement
# restent en attente dans la table outbox, sans être perdus.
# `api/tools/vider-outbox.php` est un outil de RÉESSAI MANUEL, pas un
# CRON obligatoire — il n'est pas nécessaire de le planifier.
# OUTBOX_WEBHOOK_URL=
# OUTBOX_WEBHOOK_SECRET=
# OUTBOX_BATCH_SIZE=50

# ---------------------------------------------------------------------
# Sauvegardes — CRON (api/tools/sauvegarder.php)
# ---------------------------------------------------------------------
# Dossier de destination. IMPÉRATIVEMENT HORS de public_html : une
# sauvegarde téléchargeable, c'est toute la base — clients, commandes,
# mots de passe hachés — livrée à qui devine son nom. Le script REFUSE
# de s'exécuter si ce chemin est dans la racine web.
# Défaut : <dossier parent de public_html>/katech-data/backups
# BACKUP_DIR=/home/monuser/katech-data/backups

# Nombre de sauvegardes conservées ; au-delà, les plus anciennes sont
# supprimées après chaque exécution réussie (défaut 14).
# BACKUP_KEEP=14

# Compression gzip des sauvegardes (défaut 1). Mettre 0 pour désactiver.
# BACKUP_COMPRESS=1

# ---------------------------------------------------------------------
# Note : pilote PostgreSQL — détails supplémentaires
# ---------------------------------------------------------------------
# DB_SSLMODE : mode TLS transmis à libpq. Valeurs utiles :
#   (vide)      laisse le défaut « prefer » — convient à un PostgreSQL
#               local ;
#   require     chiffrement OBLIGATOIRE, sans vérification du
#               certificat ;
#   verify-full chiffrement + vérification du nom d'hôte (le plus sûr,
#               à condition que les certificats racine soient installés).
# Un service hébergé REFUSE les connexions en clair : sans
# DB_SSLMODE=require, la connexion échoue sans que le message parle
# de TLS.
#
# Chez Supabase, précisément (section « Database » du tableau de bord) :
#   DB_HOST      db.<référence-du-projet>.supabase.co
#   DB_PORT      5432  — connexion DIRECTE. Ne pas prendre 6543 (pooler
#                en mode transaction) : il met en défaut les requêtes
#                réellement préparées côté serveur qu'utilise ce projet.
#   DB_NAME      postgres
#   DB_USER      postgres
#   DB_SSLMODE   require
# La base n'est PAS créée automatiquement : elle doit exister avant
# d'ouvrir /api/install.php.

# ---------------------------------------------------------------------
# Miroir Notion — suivi des commandes (vague 4.7)
# ---------------------------------------------------------------------
# Notion est un MIROIR : la base de données reste maîtresse du stock,
# des prix et des paiements. Notion ne pilote que le suivi (statut,
# transporteur, numéro de colis, note). Contrat complet : docs/NOTION.md.
#
# IL N'Y A RIEN À RENSEIGNER ICI POUR METTRE NOTION EN SERVICE.
# La clé de connexion se saisit dans l'écran Notion de l'administration :
# elle est chiffrée avant d'être enregistrée, et n'apparaît jamais dans
# ce fichier. Tant que rien n'est configuré, le miroir est totalement
# inerte — aucun appel réseau, aucune erreur, aucune trace.

# Clé de protection du jeton Notion (AES-256-GCM, 32 octets en base64).
# CRÉÉE AUTOMATIQUEMENT dans api/.env à la première mise en service :
# ne la renseignez pas à la main, et surtout ne la recopiez pas d'une
# installation à l'autre.
#
# POURQUOI ELLE VIT ICI ET PAS EN BASE : GET /maintenance/backup produit
# une archive de toute la base, téléchargeable depuis l'administration.
# Un jeton en clair dans la table `settings` s'y retrouverait. La clé
# étant dans .env — que la sauvegarde ne contient pas et que
# api/.htaccess interdit de télécharger — une archive volée ne livre
# qu'un jeton illisible.
#
# SI VOUS LA PERDEZ : rien de grave. Le jeton stocké devient illisible,
# le miroir se déclare « non configuré », et il suffit de ressaisir la
# clé de connexion dans l'écran Notion.
# NOTION_CRYPTO_KEY=

# URL de l'API Notion. À laisser VIDE en production.
# Ne sert qu'au développement, pour viser la doublure locale
# (api/tools/faux-notion.php) au lieu des vrais serveurs de Notion :
#   php -S 127.0.0.1:8261 api/tools/faux-notion.php
#   NOTION_API_BASE=http://127.0.0.1:8261
# NOTION_API_BASE=
